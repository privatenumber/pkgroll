{
	"compilerOptions": {
		// Node 18
		"target": "ES2022",
		"moduleDetection": "force",
		"module": "Preserve",
		"types": [
			"node",
		],
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
	},
	"include": [
		"src",
	],
}
